    "crystal-call": {
      "id": "crystal-call",
      "name": "Crystal Call",
      "castTime": 4000,
      "visible": true,
      "suspendFollow": {
        "movement": true
      },
      "effects": [
        {
          "type": "apply_status",
          "status": "fire",
          "duration": "$timers.fire",
          "target": {
            "type": "random",
            "count": 1,
            "role": "damage"
          }
        },
        {
          "type": "apply_status",
          "status": "fire",
          "duration": "$timers.fire",
          "target": {
            "type": "random",
            "count": 1,
            "roles": [
              "tank",
              "healer"
            ]
          }
        },
        {
          "type": "apply_status",
          "status": "water",
          "duration": "$timers.water",
          "target": {
            "type": "random",
            "count": 1,
            "role": "damage",
            "from": {
              "type": "without_status",
              "status": "fire"
            }
          }
        },
        {
          "type": "apply_status",
          "status": "water",
          "duration": "$timers.water",
          "target": {
            "type": "random",
            "count": 1,
            "roles": [
              "tank",
              "healer"
            ],
            "from": {
              "type": "without_status",
              "status": "fire"
            }
          }
        },
        {
          "type": "apply_status",
          "statusChoices": [
            "front",
            "back"
          ],
          "duration": 600000,
          "target": "all"
        },
        {
          "type": "spawn_enemy",
          "enemy": "wind-crystal",
          "enemyId": "wind-crystal",
          "position": {
            "type": "polar",
            "angle": "$windAngle.0",
            "radius": 8
          }
        },
        {
          "type": "spawn_enemy",
          "enemy": "water-crystal",
          "enemyId": "water-crystal",
          "position": {
            "type": "polar",
            "angle": "$waterFire.0",
            "radius": 8
          }
        },
        {
          "type": "spawn_enemy",
          "enemy": "fire-crystal",
          "enemyId": "fire-crystal",
          "position": {
            "type": "polar",
            "angle": "$waterFire.1",
            "radius": 8
          }
        },
        {
          "type": "recalculate_roles",
          "group": "crystal-roles"
        },
        {
          "type": "recalculate_positions",
          "group": "crystal-tanks"
        },
        {
          "type": "delayed_effects",
          "delay": 3000,
          "effects": [
            {
              "type": "recalculate_positions",
              "group": "crystal-elements"
            }
          ]
        }
      ]
    }
