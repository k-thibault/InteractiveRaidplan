  "batches": {
    "fire": {
      "window": 1000,
      "effects": [
        {
          "type": "select_group",
          "name": "fire-targets",
          "selector": {
            "type": "nearest",
            "source": "fire-crystal",
            "count": "$batchCount"
          }
        },
        {
          "type": "for_each_group",
          "group": "fire-targets",
          "effects": [
            {
              "type": "spawn_area",
              "area": "fire-donut",
              "source": "$groupMember.id",
              "position": "$groupMember.position"
            }
          ]
        }
      ]
    },
    "water": {
      "window": 1000,
